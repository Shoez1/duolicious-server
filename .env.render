# Variáveis de ambiente para o Render (free tier)
# Copie estas para Environment Variables no painel do Render

# Ambiente
DUO_ENV=prod

# Database (Render injeta automaticamente se usar render.yaml)
DUO_DB_HOST=
DUO_DB_PORT=5432
DUO_DB_USER=postgres
DUO_DB_PASS=

# Redis (Render injeta automaticamente se usar render.yaml)
DUO_REDIS_HOST=
DUO_REDIS_PORT=6379

# Storage (S3/R2 compatível)
DUO_R2_BUCKET_NAME=s3-mock-bucket
DUO_R2_AUDIO_BUCKET_NAME=s3-mock-audio-bucket
DUO_R2_ACCT_ID=dev
DUO_R2_ACCESS_KEY_ID=s3-mock-access-key-id
DUO_R2_ACCESS_KEY_SECRET=s3-mock-secret-access-key-secret
DUO_BOTO_ENDPOINT_URL=http://localhost:9090

# CORS
DUO_CORS_ORIGINS=*

# SMTP (configure um real em produção)
DUO_SMTP_HOST=smtp
DUO_SMTP_PORT=1025
DUO_SMTP_USER=unused
DUO_SMTP_PASS=unused

# Report email
DUO_REPORT_EMAIL=duolicious@example.com 20 a@example.com 0
